# Site
NEXT_PUBLIC_SITE_URL=https://sharonply.com

# Error Monitoring (Sentry)
# Get your DSN from https://sentry.io/settings/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# MySQL (Hostinger managed database)
# Option A: individual vars
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=sharonply
DATABASE_USER=
DATABASE_PASSWORD=

# Option B: connection URL (overrides individual vars when set)
# DATABASE_URL=mysql://user:password@host:3306/sharonply

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SECRET=
# Long random strings, required in production (e.g. `openssl rand -hex 32`)
CSRF_SECRET=

# SMTP (Hostinger: smtp.hostinger.com, port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FORM_NOTIFY_EMAIL=admin@sharonply.com
